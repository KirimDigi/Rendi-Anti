 a.active {\r\n  color: ;\r\n}\r\n\r\n\/* ICON *\/\r\n.nav a i {\r\n  font-size: 14px;\r\n  transition: 0.3s;\r\n}\r\n\r\n.nav a span {\r\n  font-size: 11px;\r\n}\r\n\r\n.nav a.active i {\r\n  transform: translateY(-1px) scale(1.05);\r\n}\r\n\r\n\/* LIQUID INDICATOR *\/\r\n.indicator {\r\n  position: absolute;\r\n  top: 5px;\r\n  left: 0;\r\n  height: calc(100% - 10px);\r\n  background: #FFFFFFE0;\r\n  border-radius: 45px;\r\n  z-index: 1;\r\n\r\n  transition:\r\n    left 0.6s cubic-bezier(.15,1.4,.45,1),\r\n    width 0.45s ease;\r\n\r\n  box-shadow: none; \/* \u2705 flat *\/\r\n}\r\n\r\n<\/style>\r\n\r\n<nav class=\"nav\">\r\n  <span class=\"indicator\"><\/span>\r\n\r\n  <a href=\"#home\" class=\"active\">\r\n    <i class=\"fa-solid fa-house\"><\/i>\r\n    <span>Home<\/span>\r\n  <\/a>\r\n  \r\n  <a href=\"#fitur\">\r\n    <i class=\"fa-solid fa-crown\"><\/i>\r\n    <span>Fitur<\/span>\r\n  <\/a>\r\n\r\n  <a href=\"#katalog\">\r\n    <i class=\"fa-solid fa-palette\"><\/i>\r\n    <span>Katalog<\/span>\r\n  <\/a>\r\n\r\n  <a href=\"#harga\">\r\n    <i class=\"fa-solid fa-tag\"><\/i>\r\n    <span>Harga<\/span>\r\n  <\/a>\r\n\r\n  <a href=\"#cara-pesan\">\r\n    <i class=\"fa-solid fa-circle-question\"><\/i>\r\n    <span>Cara Pesan<\/span>\r\n  <\/a>\r\n<\/nav>\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function () {\r\n\r\n  const nav = document.querySelector(\".nav\");\r\n  const links = nav.querySelectorAll(\"a\");\r\n  const indicator = nav.querySelector(\".indicator\");\r\n\r\n  const sections = Array.from(links)\r\n    .map(link => document.querySelector(link.getAttribute(\"href\")))\r\n    .filter(Boolean);\r\n\r\n  function moveIndicator(el) {\r\n    const navRect = nav.getBoundingClientRect();\r\n    const elRect  = el.getBoundingClientRect();\r\n\r\n    const left  = elRect.left - navRect.left;\r\n    const width = elRect.width;\r\n\r\n    indicator.style.left  = left + \"px\";\r\n    indicator.style.width = width + \"px\";\r\n\r\n    links.forEach(link => link.classList.remove(\"active\"));\r\n    el.classList.add(\"active\");\r\n  }\r\n\r\n  \/\/ Initial\r\n  moveIndicator(nav.querySelector(\".active\"));\r\n\r\n  \/\/ Klik menu (tetap jalan seperti sebelumnya)\r\n  links.forEach(link => {\r\n    link.addEventListener(\"click\", function(e) {\r\n      e.preventDefault();\r\n      const target = document.querySelector(this.getAttribute(\"href\"));\r\n      if (target) {\r\n        target.scrollIntoView({ behavior: \"smooth\" });\r\n      }\r\n      moveIndicator(this);\r\n    });\r\n  });\r\n\r\n  \/\/ \ud83d\udd25 AUTO ACTIVE SAAT SCROLL\r\n  window.addEventListener(\"scroll\", () => {\r\n    const scrollPos = window.scrollY + window.innerHeight \/ 3;\r\n\r\n    sections.forEach((section, index) => {\r\n      if (!section) return;\r\n\r\n      const top    = section.offsetTop;\r\n      const height = section.offsetHeight;\r\n\r\n      if (scrollPos >= top && scrollPos < top + height) {\r\n        moveIndicator(links[index]);\r\n      }\r\n    });\r\n  });\r\n\r\n});\r\n<\/script>\r\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t","protected":false},"featured_media":0,"template":"","class_list":["post-494080","homepage-reseller","type-homepage-reseller","status-publish","hentry"],"_links":{"self":[{"href":"https:\/\/invitimo2.my.id\/wp-json\/wp\/v2\/homepage-reseller\/494080","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/invitimo2.my.id\/wp-json\/wp\/v2\/homepage-reseller"}],"about":[{"href":"https:\/\/invitimo2.my.id\/wp-json\/wp\/v2\/types\/homepage-reseller"}],"version-history":[{"count":0,"href":"https:\/\/invitimo2.my.id\/wp-json\/wp\/v2\/homepage-reseller\/494080\/revisions"}],"wp:attachment":[{"href":"https:\/\/invitimo2.my.id\/wp-json\/wp\/v2\/media?parent=494080"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}