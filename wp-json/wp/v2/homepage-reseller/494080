_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<script>\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        const buttons = document.querySelectorAll(\".btn_catalog\");\n        const spans = document.querySelectorAll(\".btn_catalog_span\");\n\n        buttons.forEach((button, index) => {\n            button.addEventListener(\"click\", function () {\n                buttons.forEach(btn => btn.classList.remove(\"active\"));\n                spans.forEach(span => span.classList.remove(\"active\"));\n                this.classList.add(\"active\");\n                spans[index].classList.add(\"active\");\n            });\n        });\n    });\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1df516da elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile elementor-widget elementor-widget-html\" data-id=\"1df516da\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<script>\n    document.addEventListener('DOMContentLoaded', () => {\n    const buttons = {\n        btn_3d: 'tema_3d',\n        btn_art: 'tema_art',\n        btn_luxury: 'tema_luxury',\n        btn_special: 'tema_special',\n        btn_adat: 'tema_adat',\n        btn_non_foto: 'tema_non_foto',\n        btn_khitan: 'tema_khitan',\n        btn_aqiqah: 'tema_aqiqah',\n    };\n\n    \/\/ Sembunyikan semua section\n    function hideAllSections() {\n        Object.values(buttons).forEach(sectionId => {\n            document.getElementById(sectionId).style.display = 'none';\n        });\n    }\n\n    \/\/ Tambahkan event listener untuk setiap tombol\n    Object.entries(buttons).forEach(([buttonId, sectionId]) => {\n        const button = document.getElementById(buttonId);\n        const section = document.getElementById(sectionId);\n\n        if (button && section) {\n            button.addEventListener('click', () => {\n                hideAllSections(); \/\/ Sembunyikan semua section\n                section.style.display = 'block'; \/\/ Tampilkan section yang sesuai\n            });\n        }\n    });\n});\n\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8458316 elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile elementor-widget elementor-widget-html\" data-id=\"8458316\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n    .harga{\r\n    color: #444444;\r\n    font-family: \"invitajafont\", Sans-serif;\r\n    font-size: 16px;\r\n    font-weight: 500;\r\n    line-height: 1.5em;\r\n    letter-spacing: 0.5px;\r\n    }\r\n    \r\n    @media (max-width: 767px) {\r\n        .harga{\r\n        font-size: 14px;\r\n        }\r\n    }\r\n    \r\n    .harga.harga-coret{\r\n    color: #880000;\r\n    font-family: \"invitajafont\", Sans-serif;\r\n    font-size: 14px;\r\n    text-decoration: line-through;\r\n    font-style: italic;\r\n    font-weight: 500;\r\n    line-height: 1.5em;\r\n    letter-spacing: 0.5px;\r\n    }\r\n    \r\n    @media (max-width: 767px) {\r\n        .harga.harga-coret{\r\n        font-size: 12px;\r\n        }\r\n    }\r\n<\/style>\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function () {\r\n    const hargaElements = document.querySelectorAll(\".harga\");\r\n\r\n    hargaElements.forEach(function(el) {\r\n        let angka = el.textContent.replace(\/[^0-9]\/g, \"\");\r\n\r\n        if (angka !== \"\") {\r\n            let rupiah = new Intl.NumberFormat(\"id-ID\").format(angka);\r\n            el.textContent = \"Rp \" + rupiah;\r\n        }\r\n    });\r\n});\r\n<\/script>\r\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b0135b9 elem